# memory = NetworkX + numpy, no services needed (re-ingests every run)
# server = Neo4j + Qdrant from docker-compose
CINEGRAPH_BACKEND=memory

# auto = sentence-transformers if installed, else hashing fallback
CINEGRAPH_EMBEDDER=auto

NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=cinegraph-pass

QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# Optional: enables LLM answers on top of retrieval
# ANTHROPIC_API_KEY=
# CINEGRAPH_LLM_MODEL=claude-sonnet-5-5
